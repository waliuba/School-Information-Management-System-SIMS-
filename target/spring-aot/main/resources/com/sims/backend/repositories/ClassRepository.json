      "name": "existsByClassName",
      "signature": "public abstract boolean com.sims.backend.repositories.ClassRepository.existsByClassName(java.lang.String)",
      "query": {
        "query": "SELECT c.classId FROM ClassModel c WHERE c.className = :className"
      }
    },
    {
      "name": "existsByDepartmentModel_DepartmentId",
      "signature": "public abstract boolean com.sims.backend.repositories.ClassRepository.existsByDepartmentModel_DepartmentId(java.lang.Long)",
      "query": {
        "query": "SELECT c.classId FROM ClassModel c WHERE c.departmentModel.departmentId = :departmentId"
      }
    },
    {
      "name": "findByAcademicYear",
      "signature": "public abstract java.util.List<com.sims.backend.models.ClassModel> com.sims.backend.repositories.ClassRepository.findByAcademicYear(java.lang.String)",
      "query": {
        "query": "SELECT c FROM ClassModel c WHERE c.academicYear = :academicYear"
      }
    },
    {
      "name": "findByClassId",
      "signature": "public abstract java.util.Optional<com.sims.backend.models.ClassModel> com.sims.backend.repositories.ClassRepository.findByClassId(java.lang.Long)",
      "query": {
        "query": "SELECT c FROM ClassModel c WHERE c.classId = :classId"
      }
    },
    {
      "name": "findByClassNameContainingIgnoreCase",
      "signature": "public abstract java.util.List<com.sims.backend.models.ClassModel> com.sims.backend.repositories.ClassRepository.findByClassNameContainingIgnoreCase(java.lang.String)",
      "query": {
        "query": "SELECT c FROM ClassModel c WHERE UPPER(c.className) LIKE UPPER(:className) ESCAPE '\\'"
      }
    },
    {
      "name": "findByDepartmentModel_departmentId",
      "signature": "public abstract java.util.Optional<com.sims.backend.models.ClassModel> com.sims.backend.repositories.ClassRepository.findByDepartmentModel_departmentId(java.lang.Long)",
