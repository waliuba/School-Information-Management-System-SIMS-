        "query": "SELECT c FROM ClassModel c WHERE c.departmentModel.departmentId = :departmentId"
      }
    },
    {
      "name": "findByDepartmentModel_departmentIdAndAcademicYear",
      "signature": "public abstract java.util.List<com.sims.backend.models.ClassModel> com.sims.backend.repositories.ClassRepository.findByDepartmentModel_departmentIdAndAcademicYear(java.lang.Long,java.lang.String)",
      "query": {
        "query": "SELECT c FROM ClassModel c WHERE c.departmentModel.departmentId = :departmentId AND c.academicYear = :academicYear"
      }
