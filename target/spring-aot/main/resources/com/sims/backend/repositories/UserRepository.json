    {
      "name": "findByUsername",
      "signature": "public abstract java.util.Optional<com.sims.backend.models.UserModel> com.sims.backend.repositories.UserRepository.findByUsername(java.lang.String)",
      "query": {
        "query": "SELECT u FROM UserModel u WHERE u.username = :username"
