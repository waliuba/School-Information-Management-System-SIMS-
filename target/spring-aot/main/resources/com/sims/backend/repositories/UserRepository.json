      "name": "countByRole",
      "signature": "public abstract long com.sims.backend.repositories.UserRepository.countByRole(com.sims.backend.enums.Role)",
      "query": {
        "query": "SELECT COUNT(u) FROM UserModel u WHERE u.role = :role"
      }
    },
    {
      "name": "existsByEmail",
      "signature": "public abstract boolean com.sims.backend.repositories.UserRepository.existsByEmail(java.lang.String)",
      "query": {
