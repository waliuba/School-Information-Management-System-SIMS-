    },
    {
      "name": "findByUsernameContainingIgnoreCase",
      "signature": "public abstract java.util.List<com.sims.backend.models.UserModel> com.sims.backend.repositories.UserRepository.findByUsernameContainingIgnoreCase(java.lang.String)",
      "query": {
        "query": "SELECT u FROM UserModel u WHERE UPPER(u.username) LIKE UPPER(:username) ESCAPE '\\'"
      }
